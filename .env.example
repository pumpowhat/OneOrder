# Live AI: pick the provider and give it a key. AI_MODE=demo needs neither.
AI_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: override the provider's default model (gemini-3.5-flash / claude-opus-5-5)
AI_MODEL=
AI_MODE=demo
DATABASE_URL=sqlite:///./oneorder.db
# CRM (Round 3): mock serves Salesforce from samples/crm; live calls the org below
CRM_MODE=mock
SF_LOGIN_URL=
SF_CLIENT_ID=
SF_CLIENT_SECRET=
# Optional: SF_API_VERSION=62.0, SF_ORDER_EXTERNAL_ID_FIELD=OneOrder_Id__c, CRM_MOCK_DIR=samples/crm
# Optional: CRM_SYNC_WORKER=0 turns off background retries; CRM_SYNC_INTERVAL=15 (seconds)
# Demo only (CRM_MODE=mock): CRM_MOCK_FAIL=search,transient or permanent simulates a Salesforce outage
